{
  "name": "app",
  "private": true,
  "version": "1.0.3",
  "description": "ERP POS Desktop Application",
  "author": "ERP POS Team",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:prepare": "node -e \"import('fs').then(fs => { if(!fs.existsSync('dist-electron')) fs.mkdirSync('dist-electron'); fs.writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'})); })\"",
    "electron:dev": "npm run electron:prepare && concurrently \"cross-env ELECTRON=true npm run dev\" \"tsc -p tsconfig.electron.json -w\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:start": "npm run electron:prepare && tsc -p tsconfig.electron.json && electron .",
    "electron:build": "npm run electron:prepare && cross-env ELECTRON=true CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && tsc -p tsconfig.electron.json && electron-builder --win",
    "electron:publish": "npm run electron:prepare && cross-env ELECTRON=true CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && tsc -p tsconfig.electron.json && electron-builder --win --publish always",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.9",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "localforage": "^1.10.0",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.2",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0"
  }
}
