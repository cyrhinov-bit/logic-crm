{
  "appId": "com.logic.crm",
  "productName": "IC Logic CRM",
  "copyright": "Copyright © 2026 IC Logic CRM",
  "directories": {
    "output": "release/",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "forceCodeSigning": false,
  "publish": [
    {
      "provider": "github",
      "owner": "cyrhinov-bit",
      "repo": "logic-crm",
      "releaseType": "release"
    }
  ],
  "win": {
    "target": ["nsis", "portable", "zip"],
    "icon": "build/icons/icon.ico",
    "signAndEditExecutable": true,
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "IC Logic CRM",
    "uninstallDisplayName": "IC Logic CRM",
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "target": ["dmg", "pkg"]
  },
  "linux": {
    "target": ["AppImage", "deb"]
  }
}
